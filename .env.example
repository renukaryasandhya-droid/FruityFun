# Required for answers, embeddings, and generated pictures
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2

# Required for corpus ingestion and dense retrieval
PINECONE_API_KEY=
PINECONE_DENSE_INDEX=fruity-fun-dense
PINECONE_NAMESPACE=fruit-corpus-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TEXT_FIELD=text

# Retrieval tuning
TOP_K_DENSE=12
TOP_K_SPARSE=12
TOP_K_FINAL=8
RRF_K=60
CONFIDENCE_THRESHOLD=0.65

# Files
PDF_CORPUS_DIR=./data/pdfs
PROCESSED_CORPUS_PATH=./data/processed/fruit_chunks.json
IMAGE_OUTPUT_DIR=./outputs/generated
